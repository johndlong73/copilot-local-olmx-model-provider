{
  "name": "copilot-local-olmx-model-provider",
  "displayName": "copilot-local-olmx-model-provider",
  "publisher": "JohnLong",
  "description": "Bring local oMLX models into VS Code Copilot Chat",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:omlx",
    "onCommand:omlx.manage",
    "onCommand:omlx.checkHealth",
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "omlx",
        "displayName": "oMLX",
        "managementCommand": "omlx.manage",
        "configuration": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "oMLX server URL",
              "default": "http://localhost:8000",
              "title": "Server URL"
            },
            "apiKey": {
              "type": "string",
              "secret": true,
              "description": "API key (if oMLX server requires authentication)",
              "title": "API Key"
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "omlx.manage",
        "title": "Manage oMLX Models"
      },
      {
        "command": "omlx.checkHealth",
        "title": "oMLX: Check Server Health"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "oMLX Copilot Chat",
      "properties": {
        "omlx.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "oMLX server URL"
        },
        "omlx.apiKey": {
          "type": "string",
          "default": "",
          "description": "oMLX API key (if configured)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2",
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}